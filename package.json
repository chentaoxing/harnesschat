{
  "name": "harnesschat",
  "productName": "HarnessChat",
  "version": "0.3.2",
  "description": "Group-chat for AI coding harnesses: @-mention an agent, watch it work in real time. 像微信群一样把各 AI harness 拉进群聊派活。",
  "main": "src/main.js",
  "author": "AlphaC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node build-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.alphac.harnesschat",
    "productName": "HarnessChat",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HarnessChat",
      "artifactName": "HarnessChat-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.6.0": true
  }
}
